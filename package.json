{
  "name": "dsh-webpage-element-picker",
  "version": "0.3.0",
  "description": "DSH web bundle: pick page elements in an embedded system browser and reference them in the conversation ([label][DOMn] placeholders + read_picked_element tool).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "resources",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "browser",
    "element-picker"
  ],
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@11.9.0"
}
